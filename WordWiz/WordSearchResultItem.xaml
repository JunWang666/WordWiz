<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="WordWiz.WordSearchResultItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordWiz"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="6" Margin="4" HorizontalAlignment="Stretch">
        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="OnItemClick"
                HorizontalAlignment="Stretch">
            <StackPanel Orientation="Vertical"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Padding="8">
                <!-- 单词名 -->
                <TextBlock x:Name="WordTextBlock"
                           Text="{x:Bind Word, Mode=OneWay}"
                           FontSize="20"
                           FontWeight="Bold"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,0,4"/>
                <!-- 简短解释，单行显示，超出部分省略号 -->
                <TextBlock x:Name="ExplanationTextBlock"
                           Text="{x:Bind Explanation, Mode=OneWay}"
                           FontSize="14"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"
                           Foreground="Gray"
                           TextAlignment="Center"
                           HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Button>
    </Border>
</UserControl>
