<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WordWiz.WordSearchResultPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordWiz"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">    <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        
        <!-- 原 WordSearchResultList 的内容直接嵌入 -->
        <Grid Grid.Column="0" Padding="10" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="SearchTextBox"
                     Grid.Row="0"
                     PlaceholderText="输入关键词搜索..."
                     TextChanged="SearchTextBox_TextChanged"
                     KeyDown="SearchTextBox_KeyDown"
                     Margin="0,0,0,10"/>            <ListView x:Name="ResultsListView"
                      Grid.Row="1"
                      ItemsSource="{x:Bind Items, Mode=OneWay}"
                      SelectionMode="Single"
                      BorderBrush="Transparent"
                      BorderThickness="0"
                      ShowsScrollingPlaceholders="True"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="ResultsListView_SelectionChanged">

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WordItem">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1"
                                        Text="{x:Bind Word}"
                                        x:Phase="1"
                                        Style="{ThemeResource BaseTextBlockStyle}"
                                        Margin="12,6,0,0"
                                        FontWeight="Bold"
                                        FontSize="15"
                                       MaxLines="1"/>
                            <TextBlock  Grid.Column="1"
                                        Grid.Row="1"
                                        Text="{x:Bind Explanation}"
                                        x:Phase="2"
                                        Style="{ThemeResource BodyTextBlockStyle}"
                                        Margin="12,0,0,6"
                                        FontWeight="Light"
                                        FontSize="10"
                                        MaxLines="1"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>

            </ListView>

        </Grid>
        
        <local:WordDetails x:Name="WordDetailsControl"
            Grid.Column="1" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"
            ItemToDisplay="{x:Bind PageLevelSelectedItem, Mode=OneWay}"/>
    </Grid>
</Page>
