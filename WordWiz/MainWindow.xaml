<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WordWiz.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordWiz"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="WordWiz">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
        <!-- <MicaBackdrop Kind="Base"/> 使用Base的Mica材质-->
        <!-- <MicaBackdrop Kind="BaseAlt"/> 使用BaseAlt的Mica材质-->
        <!-- <DesktopAcrylicBackdrop/> 使用亚克力材质 -->
    </Window.SystemBackdrop>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button x:Name="myButton" Click="myButton_Click">Click Me</Button>
        <HyperlinkButton Content="Microsoft home page" NavigateUri="http://www.microsoft.com" />
    </StackPanel>
</Window>
