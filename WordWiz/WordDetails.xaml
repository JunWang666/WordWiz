<UserControl
    x:Class="WordWiz.WordDetails"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordWiz"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Padding="10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
        <TextBlock Text="详细信息" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,0,0,20"/>

        <TextBlock Text="词语 (Word):" Style="{ThemeResource CaptionTextBlockStyle}"/>
        <TextBlock Text="{x:Bind ItemToDisplay.Word, Mode=OneWay, FallbackValue='--- 请选择一个词条 ---'}"
                   Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,5,0,15" FontSize="20"/>

        <TextBlock Text="解释 (Explanation):" Style="{ThemeResource CaptionTextBlockStyle}"/>
        <TextBlock Text="{x:Bind ItemToDisplay.Explanation, Mode=OneWay, FallbackValue='N/A'}"
                   Style="{ThemeResource BodyTextBlockStyle}" Margin="0,5,0,0" TextWrapping="WrapWholeWords" FontSize="16"/>
    </StackPanel>
</UserControl>