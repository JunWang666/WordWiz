<UserControl
	x:Class="WordWiz.WordDetails"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:WordWiz"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	mc:Ignorable="d"
	Loaded="OnLoaded">
	<Grid Padding="0" RowSpacing="0">
		<Grid Grid.Row="0" x:Name="PlaceholderPanel" Visibility="Collapsed" HorizontalAlignment="Center"
		      VerticalAlignment="Center">
			<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
				<!-- Replace the Source with your illustration path if needed -->
				<Image Source="https://bing.img.run/rand_uhd.php" Width="600" Height="Auto" Stretch="Uniform" />
				<TextBlock Text="请选择一个单词以查看详细信息"
				           FontSize="18"
				           Foreground="{ThemeResource TextControlPlaceholderForeground}"
				           HorizontalAlignment="Center" />
			</StackPanel>
		</Grid>

		<Grid RowSpacing="0" Grid.Row="0" x:Name="DetalPanel">
			<Grid.RowDefinitions>
				<RowDefinition Height="Auto" />
				<RowDefinition Height="Auto" />
				<RowDefinition Height="*" />
			</Grid.RowDefinitions>


            <Grid Grid.Row="0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WordTextBlock"
               Grid.Column="0"
               Text="{x:Bind ItemToDisplay.Word, Mode=OneWay, FallbackValue='单词'}"
               Style="{ThemeResource TitleTextBlockStyle}"
               Margin="12,12,0,0" />

                <Button x:Name="favoriteButton" 
                        Click="Favorite_Click"
                        HorizontalAlignment="Right"
                        Margin="0,12,12,0">
                    <Button.ContextFlyout>
                        <Flyout x:Name="FavoriteDetailsFlyout">
                            <StackPanel Spacing="12" MinWidth="250">
                                <TextBlock Text="收藏设置" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                
                                <StackPanel Spacing="4">
                                    <TextBlock Text="标签" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <TextBox x:Name="FavoriteTagTextBox"
                                             PlaceholderText="输入标签（如：GRE, 托福, 日常等）" />
                                </StackPanel>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="重要度" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <Slider x:Name="FavoriteImportanceSlider"
                                            Minimum="1"
                                            Maximum="5"
                                            Value="3"
                                            TickFrequency="1"
                                            TickPlacement="Outside"
                                            SnapsTo="Ticks"
                                            ValueChanged="FavoriteImportanceSlider_ValueChanged" />
                                    <TextBlock x:Name="ImportancePreviewText"
                                               Text="★★★"
                                               HorizontalAlignment="Center"
                                               Foreground="#FFD700"
                                               FontSize="18" />
                                </StackPanel>

                                <Button Content="保存收藏"
                                        HorizontalAlignment="Stretch"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Click="SaveFavoriteDetails_Click" />
                            </StackPanel>
                        </Flyout>
                    </Button.ContextFlyout>
                    <FontIcon FontFamily="Segoe MDL2 Assets" 
                              Glyph="{x:Bind GetFavoriteIconGlyph(ItemToDisplay.Word), Mode=OneWay}"
                              FontSize="18"
                              Foreground="#FFFBD40B"/>
                </Button>
            </Grid>

            <SelectorBar Grid.Row="1" x:Name="DictionarySelectorBar"
			             SelectionChanged="DictionarySelectorBar_SelectionChanged">
			</SelectorBar>


			<WebView2 Grid.Row="2"
			          x:Name="DictionaryWebView"
			          DefaultBackgroundColor="Transparent">
				<WebView2.OpacityTransition>
					<ScalarTransition Duration="0:0:0.200" />
				</WebView2.OpacityTransition>
			</WebView2>
		</Grid>
	</Grid>
</UserControl>