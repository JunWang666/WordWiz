<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WordWiz.GeneralSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordWiz"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            
            <!-- 外观设置 -->
            <StackPanel Spacing="12">
                <TextBlock Text="外观" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                <!-- 深色模式切换 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="主题模式" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                        <TextBlock Text="选择应用程序的外观主题" 
                                   Style="{ThemeResource CaptionTextBlockStyle}" 
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                            <RadioButton x:Name="LightThemeRadio" 
                                         Content="浅色" 
                                         GroupName="ThemeMode"
                                         Checked="ThemeRadio_Checked"
                                         Tag="light"/>
                            <RadioButton x:Name="DarkThemeRadio" 
                                         Content="深色" 
                                         GroupName="ThemeMode"
                                         Checked="ThemeRadio_Checked"
                                         Tag="dark"/>
                            <RadioButton x:Name="SystemThemeRadio" 
                                         Content="跟随系统" 
                                         GroupName="ThemeMode"
                                         Checked="ThemeRadio_Checked"
                                         Tag="system"/>                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 文件夹位置 -->
            <StackPanel Spacing="12" Margin="0,24,0,0">
                <TextBlock Text="文件夹位置" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
                
                <!-- 本地数据文件夹 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="本地数据文件夹" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="LocalFolderPathText" 
                                       Text="加载中..." 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="OpenLocalFolderButton"
                                Grid.Column="1" 
                                Content="打开" 
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OpenFolderButton_Click"
                                Tag="local"/>
                    </Grid>
                </Border>

                <!-- 本地缓存文件夹 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="本地缓存文件夹" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="LocalCacheFolderPathText" 
                                       Text="加载中..." 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="OpenLocalCacheFolderButton"
                                Grid.Column="1" 
                                Content="打开" 
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OpenFolderButton_Click"
                                Tag="cache"/>
                    </Grid>
                </Border>

                <!-- 临时文件夹 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                        CornerRadius="8" 
                        Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="临时文件夹" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="TemporaryFolderPathText" 
                                       Text="加载中..." 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="OpenTemporaryFolderButton"
                                Grid.Column="1" 
                                Content="打开" 
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OpenFolderButton_Click"
                                Tag="temp"/>
                    </Grid>
                </Border>

                <!-- 共享本地文件夹 -->
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                            CornerRadius="8" 
                            Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="共享本地文件夹" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="SharedLocalFolderPathText" 
                                       Text="加载中..." 
                                       Style="{ThemeResource CaptionTextBlockStyle}" 
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="OpenSharedFolderButton"
                                Grid.Column="1" 
                                Content="打开" 
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OpenFolderButton_Click"
                                Tag="shared"/>
                    </Grid>
                </Border>
                
            </StackPanel>
            
            <!-- 应用信息 -->
            <TextBlock Text="关于" Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="SemiBold"/>
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" 
                    CornerRadius="8" 
                    Padding="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Image x:Name="AppLogo" 
                       Source="ms-appx:///Logo.png"
                       Width="100" 
                       Height="100" 
                       Margin="0,0,12,0"
                       VerticalAlignment="Top"/>
                    <StackPanel Spacing="12" Margin="0,0,0,0">
                        <StackPanel Spacing="4">
                            <TextBlock Text="WordWiz" Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            <TextBlock x:Name="AppVersionText" Text="版本 加载中..." Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="一个功能强大的英语词典应用" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
