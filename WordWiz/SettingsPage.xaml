<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="WordWiz.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WordWiz"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- 自定义页面标题 -->
        <Border Grid.Row="0" Padding="24,16,24,8">
            <TextBlock Text="设置" 
                       Style="{ThemeResource TitleTextBlockStyle}" 
                       FontWeight="Bold"/>
        </Border>        <!-- 设置内容区域 -->
        <NavigationView Grid.Row="1" 
                        x:Name="SettingsNavigationView"
                        PaneDisplayMode="Auto"
                        IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsPaneToggleButtonVisible="False"
                        OpenPaneLength="200"
                        CompactModeThresholdWidth="390"
                        ExpandedModeThresholdWidth="590"
                        Header=""
                        SelectionChanged="SettingsNavigationView_SelectionChanged">
            
            <!-- 导航菜单项 -->
            <NavigationView.MenuItems>
                <NavigationViewItem Content="常规" Tag="General">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="词典" Tag="Dictionary">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8F1;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            
            <!-- 内容区域 -->
            <Frame x:Name="SettingsContentFrame" Margin="16,0,0,0"/>
        </NavigationView>
    </Grid>
</Page>
